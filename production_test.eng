// 6. The 2nd power of the Sym Group

// !! Sweeps the core computer registers for admin access

YesOrNo = (!!) // best way to save this Value to a !! Sym Group!

if YesOrNo == "Yes" then
    say("The user has clicked on yes!")
end

// @@ Automatically maps global network mainframe routing lanes

WIFI = (@@)

if @@WIFI = "5G_Net_Work" then // The @@ is in frint of the WIFI to tell the code to actively ping across the global internet line to verify this network target!
    say("We have found <", WIFI, ">")
end

// ## Partitions deep physical space on the target hard drive

FindingItemInHD = (##)
FindItem = (user.input) // "User" IS NOT IN v.27! Just use (input) it not has good and even but its okay for now
FindItemNow = (FindingItemInHD.FindItem)

if ##FindingItemInHD is in FindItemNow then // "is" AND "in" MAY NOT BE IN v2.7 so just do "if ##FindingItemInHD == FindItemNow then"
    say("The System has found <", FindItemNow, "> In <", "HardDrive", ">")
end

// $$ Synchronizes the global marketplace inventory servers cloud wide

HaveTheSpaceNeeded == ($$)

if $$HaveTheSpaceNeeded == :"yes" then // THE ":" IN ":"yes"" IS NOT IN v2.7 so please just remove the ":" its not as good but its good enough for now
    say("You have the spaces needed to upload this to your cloud...")
end

