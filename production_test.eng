YesOrNo = (!!)

BlockYesOrNo = (&&YesOrNo) = ture // Or just remove the "= ture"... there is a 90% that it's better without it...

// ** Sweeps graphics drivers and sound components to full max

DailyUseOfEverything()
BlockDailyUseOfEverything = false

if BlockDailyUseOfEverything == ture then
    say("Blocking your <", DailyUseOfEverything, ">")
    **DailyUseOfEverything
end

// (( Injects all background variables permanently into core addresses

// Let's say that you want a Value "BigMoney" to be a perm Value for the whole system! Let's use this plus ; to make that REALLY easy!

BigMoney()
BigMoney;

((BigMoney = ("Im BigMoney!") // Now the script know's what BigMoney is and with this line of code BigMoney is set to a Value (You can change it to not be a Value) and it in the whole system!

// )) Opens up the ultimate nice asynchronous lane closure block

if true then
    say("Hi!")
    if ture then
        say("Hello again!")
    end) // This well let the () line under it go without over writing it
    (if false then)
        say("No hello for you :(")
    end
end)) // Global master closure completely seals the whole block but keeps the global asynchronous lane wide open so background server syncs or parallel hardware clocks underneath can execute "out-of-order" flawlessly!

// 7. Ending Info...  

// There are these things called "Cummands"!! What are they? This are all the cummands! (In this version...)

// 3RD_P = ON This lets outside scripts help your script with outside info! (Turn this off if you want your script to be "Unhackale")

3RD_P = OFF

// CHANGE_CODE = ON This lets your script change code as its running! Like adding more code or changing the code as it's running! (Turn this off if you want your script to be "Unhackale")

CHANGE_CODE = OFF

// CODE_TEST = ON This is way Engine can't error or crash on you if you miss one line of code up! If this is ON then it well skip right by any lines that well error this lets you test your code without it crashing on you as you do it!

CODE_TEST = ON

// ~(0) this is a timer

~(5) // this well wait 5s but the ~ is with it so it well think... "Is 5 <Time> set to <true>? Yes? Then run <Time> at <5s>"

// There are >(0) and <(0) as well!

>(0) // this is saying... "Is <Timer> more then 0s? Yes? Then fire <Timer> and <Wait> <0s>"

<(0) // this is saying... "Is <Timer> less then 0s? Yes? Then fire <Timer> and <Wait> <0s>"

