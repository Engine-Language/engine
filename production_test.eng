// 1. Learing the Run command

run Hello \\ = { // you type your code here! but only the {} if it over one line
    Money()
    Money += 1
    if Money == 2 then
        say("Your money is over $2! Go buy something!")
    end
}

Hello // This fire's the Hello but Hello is a command what kind of command? A Run command! So is well fire code

