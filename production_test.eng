// 3. Learing the Sym Group

// ! Locks down a specific local system folder or resource path so background processes can't turn it off

Money()
[Money(Money + Money ^ 10 + 1)] // Now even if the script stops this line of code well not

// @ Points to a single variable space or local memory slot on your computer screen

Money()



// # Marks a single line of text or a number as a temporary data category placeholder

Money()

if #Money == "510" then
    say("Your Money is over 510+!")
end

// $  Checks or updates a numeric variable value inside your game code (like character money or items)

Money()
$Money

if Money == Money then
    Say("A easy way to get a ture or just use if true then!")
end

// % Tells your computer CPU to divide a single code action into a lightweight background process

// Lets say that "Money" ='s 3.5112952

Money()
Money(%Money) // now Money ='s 3 and not 3.5112952!

// ^ If its in a () then it's math going to the power but if its in code then its setting a Value to = something else in that part of the code only

Money()

if true then
    say("This is the start of the part of this script")
    Money^ = "Hello!" // Now Money ='s Hello! in there but out of this script its the same value as it was before this part of the script
    if Money == "Hello!" then
        say("Money ='s Hello!")
    end
end

// & Checks two separate local conditions at the exact same time in two ways!

FakeMoney()
Money()

if Money & FakeMoney == 0 then
    say("Money plus FakeMoney are both at 0!")
end

if #&%Money & #&%FakeMoney == 0 then
    say("Money and FakeMoney are at 0!")
end

// *  Multiplies local numeric data streams together

Money()

[Money] * 5 // Now there are 5 Money's!

// ( Wraps local calculation strings and temporary math equations

Money()
(Money = 10 + 5)


// ) Executes a true Value Injection Statement, locking brand-new values and calculations directly into a variable's core address permanently so it never turns into a ghost variable!

Money()
(Money(Hello ^ 10))

// and lets say you have some lines of code in () like this

(if true then) // if its inside of () like the whole line this well now fire first before anyother lines but what if its in a part?

if true then
    if true then
        say("Hi!")
    end) // the end has a ) at the end of it to let other () line's go without overwriting it!
    else
    if false then
        (Money += 10) // this well fire before the first if then does!
    end
end

// 4. Learing the last key's...

// ` The Inverse Modifier

if Money `~ 100 then // Its looking for is Money does NOT match with 100 then
    say("Money is not a match for 100")
end

// ~ Equality Matching Check

if Money ~ FakeMoney then // If Money is a MATCH with FakeMoney if true then
    say("Money is a match for FakeMoney")
end

// , The Stream Separator

say("Hello there! You have $", Money, "What are you going to buy with that?")

// Lets say you were making a game and you have a Model named "Killer" and you have a hitbox in that model and in that hitbox is a value! How do you get that?

[Killer],hitbox,value

// ; Its like roots in a tree! It goes into the system or were ever the script is hinding and it can grap info! 

for every; [ScriptName],Script2,;,Money do
    Money =; [ScriptName],Script2,;,Money do // Now if you had a 2nd script in the games file's it well let Money to that script's money! (If it has a Value named "Money")
end

// Or it can put Value's into the system

if Money `~ 10 then
    ;Money // This uploads a Value named "Money" into the system with the same Value
end; // this ends all ;'s from existing in this part of the script (MAY NOT BE IN v2.7 OR UNDER!)

// Or you can do this!

Money();;Graphics()

// : // Developer Rule: Links sub-folders and deep library modules together, letting your script path dive down straight into specific system network spaces

System:Network:Tunnel()

// ? Quick Status Check

Money? // background status check, logging its current state directly to your hidden console terminal or aka what I call it "The Log"

// \ 1/2 Tell's the script to read one half of the code...

Money = "Hi!" \ Money = "Not hi :("

// \\ 2/2 Tell's the script to read both sides... (ONLY TO SET A VALUE TO A NON VALUE)

run Hello \\ Money += 1 // The 1st \ tell's the script to read "Hello" as a Command but what does the command do? That's the 2nd \ the 2nd \ tell's the script what to set the Hello Value to!

// {} Holds lines of code or is a Table...

run \\ = { Money += 10
    if Money >= 100 then
        say("Money is over 100!")
    end
}

// Or a Table

Cash = {
    "Hello",
    "Bye!"
}

// [] The Hardware Driver Component Target

Hello = [TargetName],SomethingInThatTarget,SomethingInThatTarget

// - Gose from one thing to the next

if Money == 10-100 then
    say(:"Money Is at 10-100!") // (THE ":" IN THE SAY IS NOT IN v2.7!)
    say("Money is at 10-100!") // In v2.7
end

// 5. Events/Function

// say() Lets you print a saying into the hard system

say("If you made a log or something is logging every say that happens then this well show up!")

// run()

// Hey! We did this one :/ it was the first one! Or the 2nd idk

// input the raw data from any "input" that the system can read or can get from and outside or inside help

I = if(key.input)
T = then(littlekey.input)
N = (==(little.input))
E = end(littlekey.input)

I #&%Money N 10 T
    say("Hi!")
E

// key Key ='s the Main keys that are used in raw coding Language code! like "if, for, etc!"

if (if(key)) == (if(key)) then
    say("The <", "if", "> Key was found and set to <", "if", ">!")
end

// littlekey It's the same thing as the key but for the little keys still needed but a lot less powerfull like "then, end, etc"

N = (==(little.input))
T = then(littlekey.input)

if true T
    // do nothing
E

// stop() This lets you stop any Function from happening!

(stop.data) // this stops all raw data from being used for the script! (This may stop the script from running in the first please to remember that)
(stop.littlekey) // this stops all little key's from being set!
// Or even!
(stop.stop)
// Now remember! All []!'s do not stop for any stop's

// hypnotic This well perm stop any Function's unlike "stop" that stop's then this means that even []!'s cant say no!

